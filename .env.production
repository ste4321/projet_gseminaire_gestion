# Utilisé par `npm run build` : API en ligne (même backend que le site vitrine)
REACT_APP_API_URL=https://api.gstf-faliarivo.ovh/api

# Notifications d'annonces en direct : à renseigner avec la valeur REVERB_APP_KEY du .env du serveur.
# Vide = pas de direct ; les nouvelles annonces apparaissent au prochain chargement de la page.
REACT_APP_REVERB_KEY=
REACT_APP_REVERB_HOST=api.gstf-faliarivo.ovh
REACT_APP_REVERB_PORT=443
REACT_APP_REVERB_SCHEME=https
