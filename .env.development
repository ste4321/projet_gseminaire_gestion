# Utilisé par `npm start` : backend Laravel lancé en local (php artisan serve)
REACT_APP_API_URL=http://127.0.0.1:8000/api

# Notifications d'annonces en direct (serveur WebSocket Laravel Reverb : php artisan reverb:start)
